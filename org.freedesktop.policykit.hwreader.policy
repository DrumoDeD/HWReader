<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://freedesktop.org">
<policyconfig>

  <vendor>HWReader</vendor>
  <vendor_url>https://github.com/DrumoDeD/HWReader</vendor_url>

  <action id="org.freedesktop.policykit.pkexec.dmidecode">
    <description>Run dmidecode without password for HWReader</description>
    <message>Authentication is required to read hardware memory tables</message>
    <icon_name>audio-card</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/dmidecode</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>

</policyconfig>
